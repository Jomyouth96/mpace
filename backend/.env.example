# Copy this file to ".env" (same folder) and fill in your own values.
# Never commit the real ".env" file or share it — it holds a password.
#
# Without these set, the backend still works fine — it just skips
# sending the notification email and logs a message instead.

# Gmail example: use an "App Password", not your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (requires 2-Step
# Verification to be turned on for the Google account first).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password

# Who receives the "new question" notification. Defaults to SMTP_USER
# if left blank, so you can leave this out if it's the same inbox.
NOTIFY_TO=your-address@gmail.com

# Password for the admin panel (website/admin.html) — required for anyone
# to log in and add/edit stories or products. Pick your own; there is no
# default. FLASK_SECRET_KEY is generated automatically on first run, so
# you don't need to set that one yourself.
ADMIN_PASSWORD=choose-your-own-password
